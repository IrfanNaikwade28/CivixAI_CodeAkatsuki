# ─── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Database (Neon PostgreSQL for production) ─────────────────────────────────
# Leave unset to use local SQLite for development.
# Production: postgres://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# ─── Cloudinary (production media storage) ────────────────────────────────────
# Leave unset to use local filesystem media/ for development.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Gemini AI ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ─── CORS (production) ────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=

# ─── Security ─────────────────────────────────────────────────────────────────
SECURE_SSL_REDIRECT=False
